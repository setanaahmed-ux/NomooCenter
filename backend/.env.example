# --- Core (required) ---
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- Google Meet for live courses (optional until you go live) ---
# 1. Create a Google Cloud project, enable the Google Calendar API.
# 2. Create a Service Account, enable "Domain-wide delegation" on it,
#    and grant it the https://www.googleapis.com/auth/calendar scope
#    in your Google Workspace admin console.
# 3. Download the service account JSON key and paste its contents
#    (as a single-line string) below, or point to a file path instead.
# 4. GOOGLE_IMPERSONATE_EMAIL is the Workspace user whose calendar will
#    host the events (e.g. courses@nomoo.ai). Domain-wide delegation is
#    required because personal Gmail accounts cannot auto-create Meet
#    links via the API.
# Until these are set, live sessions accept a manually-pasted Meet link.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_EMAIL=

# --- Google Cloud / Gemini (powers every AI feature: lesson-script
# generation, the community/tutor assistant, etc.) ---
# Simplest path for MVP: create a project at https://aistudio.google.com,
# generate an API key there (Generative Language API), paste it below.
# Same Google Cloud project can later be upgraded to Vertex AI with the
# service account above if you want IAM-based auth instead of an API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Avatar tutor (optional until you enable it) ---
# D-ID (https://www.d-id.com) turns a lesson script + a presenter photo
# into a talking-avatar video. Create an account, grab your API key.
D_ID_API_KEY=
# Default presenter image URL used when a lesson doesn't specify its own
# (e.g. the NOMOO mascot or founder photo, hosted somewhere public).
D_ID_DEFAULT_PRESENTER_IMAGE_URL=
